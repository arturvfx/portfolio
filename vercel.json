{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/contact.html", "destination": "/contact", "permanent": true },
    { "source": "/admin.html", "destination": "/admin", "permanent": true },
    { "source": "/featured-work.html", "destination": "/featured-work", "permanent": true },
    { "source": "/content-editing.html", "destination": "/content-editing", "permanent": true },
    { "source": "/digital-alchemy.html", "destination": "/digital-alchemy", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/work", "destination": "/gallery.html?view=overview" },
    { "source": "/featured-work", "destination": "/gallery.html?section=featured-work" },
    { "source": "/content-editing", "destination": "/gallery.html?section=content-editing" },
    { "source": "/digital-alchemy", "destination": "/gallery.html?section=digital-alchemy" },
    { "source": "/work/:section", "destination": "/gallery.html?section=:section" },
    { "source": "/project/:slug", "destination": "/project.html?slug=:slug" }
  ]
}
